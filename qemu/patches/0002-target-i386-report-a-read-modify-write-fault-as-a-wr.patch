+/*
+ * The load of a read-modify-write instruction's memory destination:
+ * checked for a write first, as the CPU does.
+ */
+static void gen_op_ld_rmw(DisasContext *s, int idx, TCGv t0, TCGv a0)
+{
+    gen_helper_probe_rmw(tcg_env, a0, tcg_constant_i32(1 << (idx & MO_SIZE)),
+                         tcg_constant_i32(s->mem_index));
+    gen_op_ld_v(s, idx, t0, a0);
+}
