+++ b/target/i386/tcg/misc_helper.c
@@ -47,6 +47,26 @@ void helper_into(CPUX86State *env, int next_eip_addend)
     }
 }
 
+/*
+ * The write check of a read-modify-write instruction, before its load:
+ * a CPU reads the destination for ownership, so a fault there is a write
+ * fault, with the W bit in its error code, where TCG's load alone would
+ * report a read.
+ */
+void helper_probe_rmw(CPUX86State *env, target_ulong addr, uint32_t size,
+                      uint32_t mmu_idx)
+{
+    uintptr_t ra = GETPC();
+    target_ulong first = TARGET_PAGE_SIZE - (addr & ~TARGET_PAGE_MASK);
+
+    if (size <= first) {
+        probe_write(env, addr, size, mmu_idx, ra);
+        return;
+    }
+    probe_write(env, addr, first, mmu_idx, ra);
+    probe_write(env, addr + first, size - first, mmu_idx, ra);
+}
