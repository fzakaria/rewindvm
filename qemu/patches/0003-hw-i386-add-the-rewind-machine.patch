@@ -0,0 +1,67 @@
+/*
+ * Rewind VM's machine on TCG: the deterministic machine of
+ * https://github.com/fzakaria/rewind, whose monitor runs on KVM, made a
+ * second time on QEMU's emulator so its runs replay without KVM.
+ *
+ * Copyright (c) 2026 Farid Zakaria
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_I386_REWIND_H
+#define HW_I386_REWIND_H
+
+#include "hw/i386/x86.h"
+#include "qom/object.h"
+
+#define TYPE_REWIND_MACHINE MACHINE_TYPE_NAME("rewind")
+OBJECT_DECLARE_SIMPLE_TYPE(RewindMachineState, REWIND_MACHINE)
+
+/*
+ * The step log the machine writes, which rewind's trace encoder turns
+ * into trace.bin (crates/rewind-qemu). It starts with REWIND_LOG_MAGIC
+ * and then holds entries, each a tag byte and its fields, all little
+ * endian. The machine does what rewind-vmm does to the guest; the log
+ * carries what rewind-vmm hands its trace encoders, in the same order,
+ * so the encoders stay in one place, in Rust.
+ */
+#define REWIND_LOG_MAGIC "rwqlog1\0"
+
+enum RewindLogTag {
+    /*
+     * A step began: u64 step, u64 clock. Every step has one, written
+     * where rewind-vmm drains the guest's buffered records, with the
+     * clock as the step before left it.
+     */
+    REWIND_LOG_STEP = 1,
+    /*
+     * The guest's buffered read and write records at this step: u32
+     * lost, u32 length, then the bytes.
+     */
+    REWIND_LOG_IO = 2,
+    /* The guest named its shared page: the trace encoders start here. */
+    REWIND_LOG_SETUP = 3,
+    /*
+     * A record the guest wrote to the record port at this step: u64 the
+     * clock once the step moved it, u32 length, then the record.
+     */
+    REWIND_LOG_RECORD = 4,
+    /*
+     * The machine stopped: u8 why (enum RewindStop), u64 step, u64 clock.
+     * An IO entry after it, the log's last, holds what the stop drained.
+     */
+    REWIND_LOG_END = 5,
+};
+
+/* Why the machine stopped, as rewind-vmm's Stop and Outcome name it. */
+enum RewindStop {
+    REWIND_STOP_POWER_OFF = 0,
+    REWIND_STOP_RESTART = 1,
+    REWIND_STOP_HALT = 2,
+    REWIND_STOP_TRIPLE_FAULT = 3,
+    REWIND_STOP_STALLED = 4,
+    /* The step asked for with the until property was reached. */
+    REWIND_STOP_PAUSED = 5,
+};
+
+#endif
