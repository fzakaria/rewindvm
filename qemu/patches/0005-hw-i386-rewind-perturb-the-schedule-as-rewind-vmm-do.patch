From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Farid Zakaria <farid.m.zakaria@gmail.com>
Date: Sat, 21 Nov 2026 19:33:06 -0800
Subject: [PATCH] hw/i386: rewind: perturb the schedule as rewind-vmm does

rewind check explores thread schedules by asking the guest to
reschedule, stall a task or reseed its RNG at chosen steps, and by
making some timers late. rewind-qemu works out those steps with
rewind's own Schedule and hands the machine a file of them; the
machine applies each at its step as rewind-vmm's after_step does.
---
 hw/i386/rewind.c | 78 +++++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 74 insertions(+), 4 deletions(-)

diff --git a/hw/i386/rewind.c b/hw/i386/rewind.c
index fbe70f1..afbcb85 100644
--- a/hw/i386/rewind.c
+++ b/hw/i386/rewind.c
@@ -105,6 +105,12 @@
 #define IO_BUF_MAX          (1 << 20)
 
 #define PENDING_TIMER       (1 << 0)
+#define PENDING_STALL       (1 << 4)
+#define PENDING_RESEED      (1 << 5)
+
+/* The schedule file rewind-qemu writes (crates/rewind-qemu schedule.rs). */
+#define SCHEDULE_MAGIC      "rwqsch1\0"
+#define SCHEDULE_ENTRY      (8 + 8 + 4 + 4 + RESEED_BYTES)
 
 /* The interface this machine speaks, as pv.rs's INTERFACE_VERSION. */
 #define INTERFACE_VERSION   7
@@ -151,6 +157,7 @@ struct RewindMachineState {
     char *image;
     bool extras;
     char *log_path;
+    char *schedule_path;
     uint64_t until;
 
     uint8_t seed[32];
@@ -184,6 +191,11 @@ struct RewindMachineState {
     bool record_pending;
     uint8_t *io_buf;
 
+    /* The schedule's entries, in step order, and the next one due. */
+    uint8_t *schedule;
+    size_t schedule_entries;
+    size_t schedule_next;
+
     /* MSRs KVM keeps and TCG does not (rewind_msr). */
     uint64_t mce_banks[4 * 32];
     uint64_t mcg_status;
@@ -281,6 +293,38 @@ static uint64_t pmem_start(uint64_t span)
     return ROUND_UP(span, 1 * GiB);
 }
 
+/* The schedule: what it asks of the current step, from its file. */
+
+typedef struct Perturbation {
+    uint64_t slack;
+    uint32_t reasons;
+    uint32_t stall_ns;
+    const uint8_t *reseed;
+} Perturbation;
+
+static Perturbation perturbation(RewindMachineState *s)
+{
+    Perturbation p = { 0 };
+
+    while (s->schedule_next < s->schedule_entries) {
+        const uint8_t *e = s->schedule + SCHEDULE_ENTRY * s->schedule_next;
+        uint64_t step = ldq_le_p(e);
+
+        if (step > s->step) {
+            break;
+        }
+        if (step == s->step) {
+            p.slack = ldq_le_p(e + 8);
+            p.reasons = ldl_le_p(e + 16);
+            p.stall_ns = ldl_le_p(e + 20);
+            p.reseed = e + 24;
+            break;
+        }
+        s->schedule_next++;
+    }
+    return p;
+}
+
 /* Stopping. */
 
 static void stop_machine(RewindMachineState *s, enum RewindStop why);
@@ -366,12 +410,13 @@ static bool inject(RewindMachineState *s, uint32_t reasons)
 }
 
 /*
- * Moves time for the step just taken and sends the interrupt if the timer
- * is due (lib.rs after_step). The unperturbed schedule asks for no
- * reschedule, stall or reseed.
+ * Moves time for the step just taken, and sends the interrupt if the
+ * timer is due or the schedule asks for a reschedule, a stall or a
+ * reseed here (lib.rs after_step).
  */
 static void after_step(RewindMachineState *s)
 {
+    Perturbation p = perturbation(s);
     uint32_t reasons = 0;
 
     s->now += s->quantum;
@@ -381,6 +426,15 @@ static void after_step(RewindMachineState *s)
     if (s->armed && s->now >= s->deadline) {
         reasons |= PENDING_TIMER;
     }
+    reasons |= p.reasons & ~(PENDING_STALL | PENDING_RESEED);
+    if ((p.reasons & PENDING_STALL) && s->have_shared) {
+        ram_put_u32(s->shared + SHARED_STALL_NS, p.stall_ns);
+        reasons |= PENDING_STALL;
+    }
+    if ((p.reasons & PENDING_RESEED) && s->have_shared) {
+        ram_write(s->shared + SHARED_RESEED, p.reseed, RESEED_BYTES);
+        reasons |= PENDING_RESEED;
+    }
     if (reasons && inject(s, reasons) && (reasons & PENDING_TIMER)) {
         s->armed = false;
     }
@@ -486,8 +540,9 @@ static void io_out(RewindMachineState *s, uint16_t port, uint32_t value)
         emit(s, value);
         break;
     case PORT_TIMER:
+        /* A timer the schedule makes late fires its slack later. */
         s->armed = value != 0;
-        s->deadline = s->now + value;
+        s->deadline = s->now + value + (value ? perturbation(s).slack : 0);
         break;
     case PORT_IDLE:
         /* The clock jumps to the armed timer; with none, the guest stalls. */
@@ -1425,6 +1480,18 @@ static void rewind_machine_init(MachineState *ms)
         exit(1);
     }
     log_bytes(s, REWIND_LOG_MAGIC, 8);
+    if (s->schedule_path) {
+        size_t len;
+        uint8_t *file = read_file(s->schedule_path, &len);
+
+        if (len < 8 || memcmp(file, SCHEDULE_MAGIC, 8) ||
+            (len - 8) % SCHEDULE_ENTRY) {
+            error_report("rewind: %s is not a schedule file", s->schedule_path);
+            exit(1);
+        }
+        s->schedule = file + 8;
+        s->schedule_entries = (len - 8) / SCHEDULE_ENTRY;
+    }
     s->io_buf = g_malloc(IO_BUF_MAX);
 
     /* RAM below the MMIO hole, and past 4 GiB the rest. */
@@ -1501,6 +1568,7 @@ STR_PROP(cpu_model, "cpu-model")
 STR_PROP(vendor, "vendor")
 STR_PROP(image, "image")
 STR_PROP(log_path, "log")
+STR_PROP(schedule_path, "schedule")
 #undef STR_PROP
 
 static bool get_extras(Object *o, Error **e)
@@ -1547,6 +1615,8 @@ static void rewind_machine_class_init(ObjectClass *oc, void *data)
     object_class_property_add_str(oc, "vendor", get_vendor, set_vendor);
     object_class_property_add_str(oc, "image", get_image, set_image);
     object_class_property_add_str(oc, "log", get_log_path, set_log_path);
+    object_class_property_add_str(oc, "schedule", get_schedule_path,
+                                  set_schedule_path);
     object_class_property_add_bool(oc, "extras", get_extras, set_extras);
 }
 
