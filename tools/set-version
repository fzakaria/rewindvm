#!/usr/bin/env bash
# Sets the release version everywhere it is written: VERSION, which the
# Nix packages, the site and the release workflow read, and the two
# Cargo.toml files Cargo needs it in, with their lockfiles.
# checks.version fails when they disagree. The app's RELEASE_DATE needs no
# setting: it is the day of the commit the app is built from.
#
#   tools/set-version 0.3.0
#
# Run from the repository root, inside `nix develop`.
set -euo pipefail

version=${1:?usage: tools/set-version <version>}

printf '%s\n' "$version" > VERSION
sed -i "0,/^version = \".*\"/s//version = \"$version\"/" Cargo.toml crates/rewind-app/Cargo.toml
cargo update --workspace --quiet
(cd crates/rewind-app && cargo update --package rewind-app --quiet)
echo "VERSION, Cargo.toml and crates/rewind-app/Cargo.toml say $version"
