 static void *c_start(struct seq_file *m, loff_t *pos)
 {
+#ifdef CONFIG_REWIND_GUEST
+	/* A Rewind guest may tell user space of more CPUs than it has. */
+	if (rewind_user_cpus() > 1)
+		return *pos < rewind_user_cpus() ? &cpu_data(0) : NULL;
+#endif
 	*pos = cpumask_next(*pos - 1, cpu_online_mask);
