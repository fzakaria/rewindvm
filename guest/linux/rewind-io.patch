+/*
+ * An open record for a successful open of a regular file, `fd`: the path
+ * it opened, as a read-open or, when it can write the file, a write-open.
+ * Called with rewind_path_lock held, in the same hold as the open's own
+ * event: taking the lock a second time after an event's exit would let a
+ * task woken at the first release take it in between, and run where it
+ * did not before.
+ */
+static void rewind_io_open(long fd)
+{
+	struct file *file = fget(fd);
+	char *path;
+	u8 kind;
+
+	if (!file)
+		return;
+	kind = (file->f_mode & FMODE_WRITE) ? REWIND_IO_WRITE_OPEN :
+					      REWIND_IO_READ_OPEN;
+	if (S_ISREG(file_inode(file)->i_mode)) {
+		path = d_path(&file->f_path, rewind_path_a, PATH_MAX);
+		if (!IS_ERR(path)) {
+			rewind_strip_deleted(path);
+			rewind_io_append(kind, file, path, strlen(path));
+		}
+	}
+	fput(file);
+}
