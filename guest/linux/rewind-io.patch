 /*
+ * A write record for a call that wrote `ret` bytes to a regular file:
+ * write, writev, pwrite64, pwritev, pwritev2, copy_file_range or
+ * sendfile, with where in the file the bytes went.
+ */
+static void rewind_io_write(struct pt_regs *regs, long id, long ret)
+{
+	loff_t __user *off_out;
+	struct file *file;
+	unsigned int fd;
+	loff_t end;
+	struct {
+		u64 pos;
+		u32 count;
+	} __packed w;
+
+	/* The descriptor written to. */
+	switch (id) {
+	case __NR_write:
+	case __NR_writev:
+	case __NR_pwrite64:
+	case __NR_pwritev:
+	case __NR_pwritev2:
+	case __NR_sendfile:
+		fd = regs->di;
+		break;
+	case __NR_copy_file_range:
+		fd = regs->dx;
+		break;
+	default:
+		return;
+	}
+	file = fget(fd);
+	if (!file)
+		return;
+	if (!S_ISREG(file_inode(file)->i_mode)) {
+		fput(file);
+		return;
+	}
+
+	/*
+	 * Where the bytes went: an explicit offset, which copy_file_range
+	 * has already moved past them, or else the file position, which the
+	 * call has.
+	 */
+	off_out = (loff_t __user *)regs->r10;
+	if (id == __NR_pwrite64 || id == __NR_pwritev ||
+	    (id == __NR_pwritev2 && (long)regs->r10 != -1))
+		w.pos = regs->r10;
+	else if (id == __NR_copy_file_range && off_out &&
+		 !get_user(end, off_out))
+		w.pos = end - ret;
+	else
+		w.pos = file->f_pos - ret;
+	w.count = ret;
+	rewind_io_append(REWIND_IO_WRITE, file, &w, sizeof(w));
+	fput(file);
+}
