 /*
+ * Read and write records: a write record for each write to a regular
+ * file, and an open record for each successful open of a regular file,
+ * for reading or for writing, appended to rewind_io_buf without an exit.
+ * The buffer holds what the busiest stretch between two steps of a
+ * sagittarius-scheme build appends, about 19,000 write records, with room
+ * to spare.
+ */
+#define REWIND_IO_BUF_SIZE	(1024 * 1024)
+
+enum rewind_io_kind {
+	REWIND_IO_WRITE = 1,		/* data: u64 pos, u32 count */
+	REWIND_IO_READ_OPEN = 2,	/* data: path */
+	REWIND_IO_WRITE_OPEN = 3,	/* data: path */
+};
+
+struct rewind_io_record {
+	u16 len;		/* the whole record, header included */
+	u8 kind;
+	u8 pad;
+	u32 tid;
+	u64 ino;		/* with dev, the file */
+	u32 dev;
+	u8 data[];
+} __packed;
+
+static u8 rewind_io_buf[REWIND_IO_BUF_SIZE] __aligned(PAGE_SIZE);
+
+/*
+ * Appends one record. Interrupts are off, and io_head moves only once the
+ * record is whole, so the monitor never sees a record half written.
+ */
+static void rewind_io_append(u8 kind, struct file *file, const void *data,
+			     size_t len)
+{
+	struct inode *inode = file_inode(file);
+	struct rewind_io_record *rec;
+	unsigned long irqflags;
+	u32 head, size;
+
+	len = min_t(size_t, len, PATH_MAX);
+	size = sizeof(*rec) + len;
+	local_irq_save(irqflags);
+	head = READ_ONCE(rewind_shared.io_head);
+	if (head + size > REWIND_IO_BUF_SIZE) {
+		WRITE_ONCE(rewind_shared.io_lost,
+			   READ_ONCE(rewind_shared.io_lost) + 1);
+		local_irq_restore(irqflags);
+		return;
+	}
+	rec = (struct rewind_io_record *)(rewind_io_buf + head);
+	rec->len = size;
+	rec->kind = kind;
+	rec->pad = 0;
+	rec->tid = current->pid;
+	rec->ino = inode->i_ino;
+	rec->dev = inode->i_sb->s_dev;
+	memcpy(rec->data, data, len);
+	WRITE_ONCE(rewind_shared.io_head, head + size);
+	local_irq_restore(irqflags);
+}
+
