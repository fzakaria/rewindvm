# Kernel configuration for the Rewind guest, merged over x86_64_defconfig by
# nix/kernel.nix. Most of it serves one of two ends: the run must be
# deterministic, and a boot should cost as few exits as possible. The rest
# is what a job needs of the kernel: debug information for `rewind gdb`,
# and namespaces and networking for builds that start containers.

# One vCPU, and a uniprocessor kernel: no other CPU to race with, and
# spinlocks compile away, so nothing in the kernel ever spins waiting on
# another processor.
# CONFIG_SMP is not set

# The Rewind platform, and no other hypervisor's: KVM's paravirtual clock
# reads host time.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_REWIND_GUEST=y
# CONFIG_PARAVIRT is not set
# CONFIG_KVM_GUEST is not set
# CONFIG_XEN is not set
# CONFIG_HYPERV is not set
# CONFIG_JAILHOUSE_GUEST is not set
# CONFIG_ACRN_GUEST is not set

# KASLR picks the kernel's address from RDRAND and the timestamp counter at
# decompression time, before any of the platform code runs.
# CONFIG_RANDOMIZE_BASE is not set

# No firmware tables and no buses: the platform code describes the one
# local APIC itself, and the only device is the input image, which the
# monitor maps as legacy persistent memory.
# CONFIG_ACPI is not set
# CONFIG_PCI is not set
CONFIG_X86_PMEM_LEGACY=y
CONFIG_LIBNVDIMM=y
CONFIG_BLK_DEV_PMEM=y

# Filesystems: the read-only input image, an overlay for writes on top of
# it, and tmpfs for /build and /tmp.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_LOOP=y

# The early serial console, for debugging a boot before the Rewind console
# registers.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_EARLY_PRINTK=y

# Fewer ticks mean fewer timer interrupts, and each one costs exits.
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
# x86 offers only full and lazy preemption. Either is deterministic here,
# since the kernel is only ever interrupted at an exit; lazy is upstream's
# default, and the model is fixed at build time rather than at boot.
CONFIG_PREEMPT_LAZY=y
# CONFIG_PREEMPT_DYNAMIC is not set

# Once the kernel has made its own text read-only it walks every page
# table entry looking for a page both writable and executable, and warns
# of any. The walk is a check on the kernel's own page tables, which do
# not change between boots, and costs host time on every one.
# CONFIG_DEBUG_WX is not set

# Everything built in, so the initramfs carries only the init.
# CONFIG_MODULES is not set

# Watchdogs and pollers wake on host-independent timers here, but they
# still cost exits and do nothing useful in a guest this simple.
# CONFIG_SOFTLOCKUP_DETECTOR is not set
# CONFIG_HARDLOCKUP_DETECTOR is not set
# CONFIG_DETECT_HUNG_TASK is not set
# CONFIG_WATCHDOG is not set
# CONFIG_X86_MCE is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_AUDIT is not set

# kcompactd looks for fragmented memory every half second, forever, which
# the idle CPU wakes for. The monitor takes an idle exit with no timer
# armed as the machine idle for good, and that timer would keep such a
# run going forever. The run's own --kernel-args come after this line
# and can turn the look back on.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="sysctl.vm.compaction_proactiveness=0"

# No display, no sound, no USB. The virtual terminal and input layers stay:
# they are only optional under CONFIG_EXPERT, and with no keyboard and no
# i8042 they do nothing.
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set

# DWARF and the kernel's gdb scripts, for `rewind gdb`. nix/kernel.nix
# moves them to the `debug` output; the vmlinux the VM boots carries none
# of it.
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_GDB_SCRIPTS=y

# NixOS tests with containers: the test driver runs each container with
# systemd-nspawn in a network namespace of its own, joined to a bridge per
# VLAN by a veth pair, and links the bridge to the VMs' VDE switch through
# a TAP device.
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_TUN=y

# User namespaces: init runs a build that asks for uid-range in one of
# its own, as nix-daemon does, and a systemd unit with `PrivateUsers=` in
# such a container makes another. Without them, the build cannot start,
# and the unit fails at step USER.
CONFIG_USER_NS=y

# The NixOS firewall in such a container. `iptables-nft` changes rules
# into nf_tables expressions. For a match that it cannot change, such as
# rpfilter, it uses the xtables match through NFT_COMPAT.
# `networking.nftables` uses the FIB and reject expressions directly.
# x86_64_defconfig already has the legacy iptables filter table, which
# neither needs.
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_MATCH_RPFILTER=y
CONFIG_IP6_NF_TARGET_REJECT=y
