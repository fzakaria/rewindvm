+/*
+ * Every context switch, from finish_task_switch(): the task the CPU runs
+ * from here on, as a record of its own, so the switch is an exit. The
+ * monitor only perturbs a run at exits, and a handoff between two threads
+ * that make no system call of their own would otherwise be invisible to
+ * it, and to `rewind threads`, which reads these records. The idle task
+ * is named too, pid 0, so the trace shows when nothing ran. A task past
+ * exit_mm(), or one of the kernel's own, has no memory and no program,
+ * which the flag says.
+ */
+void rewind_switch(struct task_struct *next)
+{
+	u16 flags = next->mm ? 0 : REWIND_FLAG_NO_MEMORY;
+
+	if (!rewind_running)
+		return;
+	rewind_emit(REWIND_EV_SWITCH, flags, next->tgid, next->pid, 0,
+		    next->comm, strnlen(next->comm, TASK_COMM_LEN), NULL, 0);
+}
