# Minimal, deterministic kernel configuration for the ARM64 Rewind guest
# (shared by macOS Hypervisor.framework and Linux ARM64 KVM), merged over
# `make allnoconfig` so no board/SoC drivers or host-time peripherals sneak in.

CONFIG_EXPERT=y
CONFIG_64BIT=y
CONFIG_NR_CPUS=1

# 4 KiB guest pages (matches Rewind's 4 KiB page store and page-table walker).
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_RANDOMIZE_BASE is not set

# Rewind ARM64 paravirtual platform (MMIO at 0x0900_0000 + virtual IRQ).
CONFIG_REWIND_GUEST=y
CONFIG_OF=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y

# Tracing infrastructure required by Rewind's sched/signal/syscall tracepoints.
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_TRACING=y
CONFIG_EVENT_TRACING=y
CONFIG_TRACEPOINTS=y

# Deterministic timing and preemption.
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PREEMPT_LAZY=y
# CONFIG_PREEMPT_DYNAMIC is not set
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y

# Core Linux userspace ABI.
CONFIG_MULTIUSER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_ELF_CORE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMFD_CREATE=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_DNOTIFY=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SHMEM=y

# Persistent memory (FDT pmem-region -> /dev/pmem0, /dev/pmem1) and filesystems.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_RD_GZIP=y
CONFIG_LIBNVDIMM=y
CONFIG_BLK_DEV_PMEM=y
CONFIG_OF_PMEM=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_DEFLATE=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Namespaces, cgroups, and loopback/container networking.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_MEMCG=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_TUN=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y

# Keep kcompactd's periodic timer off and allow sparse overcommit mappings.
CONFIG_CMDLINE="sysctl.vm.compaction_proactiveness=0 sysctl.vm.overcommit_memory=1"
CONFIG_CMDLINE_EXTEND=y

# Everything built in, no PMU/HW_RANDOM/ACPI/PCI/watchdogs.
# CONFIG_MODULES is not set
# CONFIG_ACPI is not set
# CONFIG_PCI is not set
# CONFIG_ARM_PMU is not set
# CONFIG_HW_RANDOM is not set
# CONFIG_DEBUG_WX is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_WATCHDOG is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
# CONFIG_XEN is not set
