+/* Stopping the machine: every way out is a port write. */
+
+static void rewind_power_off(void)
+{
+	outl(REWIND_EXIT_POWER_OFF, REWIND_PORT_EXIT);
+}
+
+static void rewind_restart(char *cmd)
+{
+	outl(REWIND_EXIT_RESTART, REWIND_PORT_EXIT);
+}
+
+static void rewind_emergency_restart(void)
+{
+	outl(REWIND_EXIT_RESTART, REWIND_PORT_EXIT);
+}
