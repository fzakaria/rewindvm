diff -ruN a/arch/x86/kernel/cpu/rewind.c b/arch/x86/kernel/cpu/rewind.c
--- a/arch/x86/kernel/cpu/rewind.c	1969-12-31 16:00:00.000000000 -0800
+++ b/arch/x86/kernel/cpu/rewind.c	1969-12-31 16:00:00.000000000 -0800
@@ -0,0 +1,1188 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Rewind VM guest platform.
+ *
+ * Rewind VM runs this kernel on KVM with one vCPU and makes the run a pure
+ * function of its inputs. The monitor never interrupts the guest on its own
+ * schedule: time is virtual, it moves only when the guest exits to the
+ * monitor, and interrupts are injected only at those exits. Every exit is a
+ * guest instruction (a port read or write), so the sequence of exits, and
+ * with it everything the guest does, is the same on every run.
+ *
+ * This file supplies the pieces a normal x86 platform gets from hardware:
+ *
+ *   - a clocksource and a one-shot clock event device backed by the
+ *     monitor's virtual clock,
+ *   - an idle routine that tells the monitor nothing is runnable, in place
+ *     of HLT, so virtual time can jump to the next armed timer,
+ *   - the wall clock at boot (the monitor passes SOURCE_DATE_EPOCH),
+ *   - power off, restart and halt as port writes,
+ *   - a console, and an event stream of exec, fork, exit, signals, file
+ *     writes and program output, each written to the monitor with the
+ *     guest physical address of a record,
+ *   - the CPU count the affinity system calls report, which may exceed the
+ *     one vCPU (rewind.cpus=).
+ *
+ * The port layout and record format must match crates/rewind-vmm.
+ */
+
+#include <linux/clockchips.h>
+#include <linux/clocksource.h>
+#include <linux/console.h>
+#include <linux/cpumask.h>
+#include <linux/fcntl.h>
+#include <linux/file.h>
+#include <linux/fs.h>
+#include <linux/fs_struct.h>
+#include <linux/init.h>
+#include <linux/kfifo.h>
+#include <linux/kstrtox.h>
+#include <linux/miscdevice.h>
+#include <linux/mm.h>
+#include <linux/mutex.h>
+#include <linux/pm.h>
+#include <linux/poll.h>
+#include <linux/reboot.h>
+#include <linux/sched.h>
+#include <linux/sched/mm.h>
+#include <linux/sched/signal.h>
+#include <linux/binfmts.h>
+#include <linux/slab.h>
+#include <linux/static_call.h>
+#include <linux/string.h>
+#include <linux/task_work.h>
+#include <linux/uaccess.h>
+#include <linux/umh.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+
+#include <trace/events/sched.h>
+#include <trace/events/signal.h>
+#include <trace/events/syscalls.h>
+
+#include <asm/apic.h>
+#include <asm/cpufeatures.h>
+#include <asm/cpuid/api.h>
+#include <asm/e820/api.h>
+#include <asm/hypervisor.h>
+#include <asm/i8259.h>
+#include <asm/idtentry.h>
+#include <asm/io.h>
+#include <asm/irq_regs.h>
+#include <asm/reboot.h>
+#include <asm/setup.h>
+#include <asm/tsc.h>
+#include <asm/syscall.h>
+#include <asm/unistd.h>
+#include <asm/x86_init.h>
+
+/* The CPUID signature the monitor advertises at leaf 0x40000000. */
+#define REWIND_SIGNATURE "RewindRewind"
+
+/* Ports the monitor traps. Each access is one exit, and one step. */
+#define REWIND_PORT_EMIT	0x5e0	/* outl: physical address of a record */
+#define REWIND_PORT_CLOCK	0x5e4	/* inl: refresh rewind_shared.now */
+#define REWIND_PORT_TIMER	0x5ec	/* outl: arm the timer, ns from now */
+#define REWIND_PORT_IDLE	0x5f0	/* outl: nothing is runnable */
+#define REWIND_PORT_EXIT	0x5f4	/* outl: stop the machine */
+#define REWIND_PORT_SETUP	0x5f8	/* outl: physical address of rewind_shared */
+
+/* Values written to REWIND_PORT_EXIT. */
+enum rewind_exit {
+	REWIND_EXIT_POWER_OFF = 0,
+	REWIND_EXIT_RESTART = 1,
+	REWIND_EXIT_HALT = 2,
+};
+
+/* Record kinds. The payload of each is described next to it. */
+enum rewind_kind {
+	REWIND_EV_CONSOLE = 1,	/* kernel log text */
+	REWIND_EV_OUTPUT = 2,	/* aux: fd (1 or 2); payload: bytes written */
+	REWIND_EV_EXEC = 3,	/* aux: old pid; payload: filename NUL argv */
+	REWIND_EV_FORK = 4,	/* aux: child tid; flags: REWIND_FLAG_THREAD */
+	REWIND_EV_EXIT = 5,	/* aux: exit code; payload: comm */
+	REWIND_EV_SIGNAL = 6,	/* aux: signal; payload: s32 code, u64 addr */
+	REWIND_EV_OPEN = 7,	/* aux: open flags; payload: path */
+	REWIND_EV_UNLINK = 8,	/* payload: path */
+	REWIND_EV_RENAME = 9,	/* payload: old path NUL new path */
+	REWIND_EV_MARK = 10,	/* payload: text written to /dev/rewind */
+};
+
+#define REWIND_FLAG_THREAD	BIT(0)
+
+/*
+ * One record, as the monitor reads it out of guest memory. len covers the
+ * whole record including this header.
+ */
+struct rewind_record {
+	u32 len;
+	u16 kind;
+	u16 flags;
+	u32 pid;
+	u32 tid;
+	u32 aux;
+	u8 data[];
+} __packed;
+
+#define REWIND_RECORD_MAX	8192
+#define REWIND_PAYLOAD_MAX	(REWIND_RECORD_MAX - sizeof(struct rewind_record))
+
+#define REWIND_REQUEST_MAX	2048
+#define REWIND_INPUT_MAX	1024
+
+/*
+ * Where `rewind gdb` finds a process's threads, written once at setup:
+ * the head of the task list, where the running task's pointer is, the
+ * direct map's base for turning mm->pgd into a page table address, and
+ * the offsets of the fields read to walk from one task to the next. A
+ * thread that is not on the CPU saved its user registers in the struct
+ * pt_regs at pt_regs bytes into its stack, so gdb can show every thread
+ * of the process it debugs, those off the CPU included.
+ */
+struct rewind_tasks {
+	u64 init_task;
+	u64 current_task;
+	u64 page_offset;
+	u64 tasks;		/* in struct task_struct, as are those to comm */
+	u64 thread_node;
+	u64 signal;
+	u64 pid;
+	u64 tgid;
+	u64 stack;
+	u64 mm;
+	u64 comm;
+	u64 thread_head;	/* in struct signal_struct */
+	u64 pgd;		/* in struct mm_struct */
+	u64 pt_regs;
+};
+
+/*
+ * The monitor reads struct pt_regs as this many u64s, in the order of
+ * ptrace's user_regs_struct: r15 to r12, bp, bx, r11 to r8, ax, cx, dx,
+ * si, di, orig_ax, ip, cs, flags, sp, ss.
+ */
+#define REWIND_PT_REGS_WORDS	21
+
+/*
+ * The page the monitor writes into: the virtual clock on every
+ * REWIND_PORT_CLOCK read, the boot wall clock once at setup, and, before
+ * each interrupt it sends, why it sent it. An inspection request comes
+ * with its arguments, and input for /dev/rewind-console with its bytes;
+ * the kernel sets input_len back to 0 once it has taken them, which is
+ * the monitor's cue to send more.
+ */
+struct rewind_shared {
+	u64 now;
+	u64 epoch;
+	u32 pending;
+	u32 request_len;
+	u8 request[REWIND_REQUEST_MAX];
+	u32 input_len;
+	u8 input[REWIND_INPUT_MAX];
+	u32 stall_ns;
+	struct rewind_tasks tasks;
+};
+
+/* Reasons for an interrupt, in rewind_shared.pending. */
+#define REWIND_PENDING_TIMER	BIT(0)	/* the armed timer is due */
+#define REWIND_PENDING_PREEMPT	BIT(1)	/* reschedule at this point */
+#define REWIND_PENDING_INSPECT	BIT(2)	/* run the request in rewind_shared */
+#define REWIND_PENDING_INPUT	BIT(3)	/* input for /dev/rewind-console */
+#define REWIND_PENDING_STALL	BIT(4)	/* stall the running task stall_ns */
+
+/*
+ * /dev/rewind-console's input: bytes the monitor sends, in arrival order.
+ * The interrupt handler is the only writer and the device's reader the
+ * only reader, which is the one case a kfifo needs no lock for.
+ */
+static DEFINE_KFIFO(rewind_input, u8, 4096);
+static DECLARE_WAIT_QUEUE_HEAD(rewind_input_wait);
+
+static struct rewind_shared rewind_shared __aligned(PAGE_SIZE);
+static u8 rewind_buf[REWIND_RECORD_MAX] __aligned(PAGE_SIZE);
+
+/*
+ * Write one record to the monitor. The record is assembled in a single
+ * static buffer with interrupts off: the vCPU is the only CPU, and nothing
+ * in this kernel raises an NMI, so nothing else can touch the buffer
+ * between the copy and the port write.
+ */
+static void rewind_emit(u16 kind, u16 flags, u32 pid, u32 tid, u32 aux,
+			const void *a, size_t alen, const void *b, size_t blen)
+{
+	struct rewind_record *rec = (struct rewind_record *)rewind_buf;
+	unsigned long irqflags;
+
+	alen = min(alen, REWIND_PAYLOAD_MAX);
+	blen = min(blen, REWIND_PAYLOAD_MAX - alen);
+
+	local_irq_save(irqflags);
+	rec->len = sizeof(*rec) + alen + blen;
+	rec->kind = kind;
+	rec->flags = flags;
+	rec->pid = pid;
+	rec->tid = tid;
+	rec->aux = aux;
+	if (alen)
+		memcpy(rec->data, a, alen);
+	if (blen)
+		memcpy(rec->data + alen, b, blen);
+	outl(__pa_symbol(rewind_buf), REWIND_PORT_EMIT);
+	local_irq_restore(irqflags);
+}
+
+/* Set once the platform is initialized, and read where tracing is off. */
+bool rewind_running __ro_after_init;
+
+/*
+ * The kernel's "cycle counter" for entropy collection. Hardware kernels
+ * read the TSC here; this one has none, and reading the virtual clock would
+ * cost an exit per sample, which the jitter entropy collector takes by the
+ * million at boot. A splitmix64 sequence instead: it varies like a counter
+ * of real cycles as far as the health tests can tell, costs nothing, and is
+ * the same on every run. The RNG's actual entropy is the seed the monitor
+ * passes at boot.
+ */
+noinstr unsigned long rewind_get_entropy(void)
+{
+	static u64 state;
+	u64 z;
+
+	/*
+	 * Entropy is sampled before the platform is detected, too. A CPU
+	 * with no TSC in CPUID is either this monitor's or one where RDTSC
+	 * would be wrong anyway.
+	 */
+	if (!rewind_running)
+		return cpu_feature_enabled(X86_FEATURE_TSC) ? rdtsc() : 0;
+
+	z = (state += 0x9e3779b97f4a7c15ULL);
+	z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+	z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+	return z ^ (z >> 31);
+}
+
+/*
+ * The scheduler's clock: the virtual time the monitor wrote at the last
+ * exit. Reading it costs no exit, so the scheduler can call it as often
+ * as it likes, and it moves exactly as the rest of the guest's time does.
+ */
+noinstr u64 rewind_sched_clock(void)
+{
+	return READ_ONCE(rewind_shared.now);
+}
+
+/*
+ * A yield costs one exit, as a system call and a context switch cost time
+ * on real hardware. Without one, a thread that yields in a loop until
+ * another thread acts makes no exit at all: the scheduler's clock stands
+ * still, so the loop uses up none of its slice, and no timer or interrupt
+ * comes due for the thread it waits on. The loop then runs forever.
+ */
+void rewind_yield(void)
+{
+	if (rewind_running)
+		inl(REWIND_PORT_CLOCK);
+}
+
+static u32 __init rewind_detect(void)
+{
+	if (boot_cpu_data.cpuid_level < 0 ||
+	    !boot_cpu_has(X86_FEATURE_HYPERVISOR))
+		return 0;
+
+	return cpuid_base_hypervisor(REWIND_SIGNATURE, 0);
+}
+
+/* The clock: one exit per read, and each read moves virtual time. */
+
+static u64 rewind_clock_read(struct clocksource *cs)
+{
+	inl(REWIND_PORT_CLOCK);
+	barrier();
+	return READ_ONCE(rewind_shared.now);
+}
+
+static struct clocksource rewind_clocksource = {
+	.name	= "rewind",
+	.rating	= 400,
+	.read	= rewind_clock_read,
+	.mask	= CLOCKSOURCE_MASK(64),
+	.flags	= CLOCK_SOURCE_IS_CONTINUOUS,
+};
+
+/* The timer: armed in nanoseconds, fired by the monitor at an exit. */
+
+static int rewind_set_next_event(unsigned long delta,
+				 struct clock_event_device *evt)
+{
+	outl(delta, REWIND_PORT_TIMER);
+	return 0;
+}
+
+static int rewind_timer_shutdown(struct clock_event_device *evt)
+{
+	outl(0, REWIND_PORT_TIMER);
+	return 0;
+}
+
+static struct clock_event_device rewind_clockevent = {
+	.name			= "rewind",
+	.features		= CLOCK_EVT_FEAT_ONESHOT,
+	.rating			= 400,
+	.set_next_event		= rewind_set_next_event,
+	.set_state_shutdown	= rewind_timer_shutdown,
+	.set_state_oneshot_stopped = rewind_timer_shutdown,
+};
+
+/*
+ * Inspection: in a run forked from a recording, the monitor asks what the
+ * machine looks like inside at that step, such as a file's contents. The
+ * request is a list of NUL-terminated arguments in rewind_shared.request,
+ * and the answer comes from /init started with --inspect and those
+ * arguments, which reports through the Rewind devices like any process.
+ * A recording never carries a request, so this changes no recorded run.
+ *
+ * While an inspection runs, every other user process is stopped, init
+ * waits at its next system call, and power off waits for the inspection
+ * to finish, so neither the job nor init can change what the inspection
+ * reads, start anything new, or end the machine under it.
+ */
+#define REWIND_INSPECT_ARGS	8
+
+static bool rewind_inspecting;
+static DECLARE_WAIT_QUEUE_HEAD(rewind_inspect_done);
+
+/*
+ * The process that was running at the step the inspection asks about, by
+ * its thread group id, or 0 when the kernel or the idle task was. The
+ * inspection's process gets it as REWIND_RUNNING, so Rewind can tell gdb
+ * whose program and libraries were mapped at that step.
+ */
+static pid_t rewind_inspect_running;
+
+/*
+ * Stops every user process but init where it stands. Called from the
+ * interrupt, so the machine stops at the step the monitor asked about
+ * rather than whenever the worker gets to run. Linux never stops init with
+ * a signal, so init is held at its next system call instead
+ * (rewind_probe_sys_enter), before it can start the job or anything else.
+ */
+static void rewind_stop_user_tasks(void)
+{
+	struct task_struct *p;
+
+	rcu_read_lock();
+	for_each_process(p) {
+		if ((p->flags & PF_KTHREAD) || is_global_init(p))
+			continue;
+		send_sig(SIGSTOP, p, 1);
+	}
+	rcu_read_unlock();
+}
+
+static void rewind_inspect(struct work_struct *work)
+{
+	static char request[REWIND_REQUEST_MAX + 1];
+	static char *argv[REWIND_INSPECT_ARGS + 3];
+	static char running[sizeof("REWIND_RUNNING=-2147483648")];
+	static char *envp[] = { "PATH=/bin", running, NULL };
+	u32 len = min_t(u32, READ_ONCE(rewind_shared.request_len),
+			REWIND_REQUEST_MAX);
+	int argc = 0;
+	char *arg;
+
+	memcpy(request, rewind_shared.request, len);
+	request[len] = '\0';
+
+	argv[argc++] = "/init";
+	argv[argc++] = "--inspect";
+	for (arg = request; arg < request + len && argc < ARRAY_SIZE(argv) - 1;
+	     arg += strlen(arg) + 1)
+		argv[argc++] = arg;
+	argv[argc] = NULL;
+	snprintf(running, sizeof(running), "REWIND_RUNNING=%d",
+		 READ_ONCE(rewind_inspect_running));
+
+	call_usermodehelper(argv[0], argv, envp, UMH_WAIT_PROC);
+
+	WRITE_ONCE(rewind_inspecting, false);
+	wake_up_all(&rewind_inspect_done);
+}
+
+/* Power off, restart and halt wait for a running inspection. */
+static int rewind_reboot_notify(struct notifier_block *nb,
+				unsigned long action, void *data)
+{
+	wait_event(rewind_inspect_done, !READ_ONCE(rewind_inspecting));
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block rewind_reboot_nb = {
+	.notifier_call = rewind_reboot_notify,
+};
+
+static DECLARE_WORK(rewind_inspect_work, rewind_inspect);
+
+/*
+ * Stalls: under a schedule seed, the monitor asks for the task running at
+ * a step to sleep for a while when it next returns to user space, as a
+ * busy machine deschedules a process now and then. Many races need one
+ * task held up for a while, which a reschedule alone does not do. The
+ * sleep is on a high resolution timer, so it ends at a deterministic
+ * point of virtual time.
+ */
+struct rewind_stall {
+	struct callback_head work;
+	u32 ns;
+};
+
+static void rewind_stall_now(struct callback_head *head)
+{
+	struct rewind_stall *stall = container_of(head, struct rewind_stall, work);
+	unsigned long us = max(stall->ns / NSEC_PER_USEC, 1U);
+
+	kfree(stall);
+	usleep_range(us, us);
+}
+
+static void rewind_stall_current(void)
+{
+	struct rewind_stall *stall;
+
+	if (!current->mm || (current->flags & PF_KTHREAD))
+		return;
+	stall = kmalloc(sizeof(*stall), GFP_ATOMIC);
+	if (!stall)
+		return;
+	stall->ns = READ_ONCE(rewind_shared.stall_ns);
+	init_task_work(&stall->work, rewind_stall_now);
+	if (task_work_add(current, &stall->work, TWA_RESUME))
+		kfree(stall);
+}
+
+/* Takes the input the monitor left in the shared page. */
+static void rewind_take_input(void)
+{
+	u32 len = min_t(u32, READ_ONCE(rewind_shared.input_len),
+			REWIND_INPUT_MAX);
+
+	kfifo_in(&rewind_input, rewind_shared.input, len);
+	WRITE_ONCE(rewind_shared.input_len, 0);
+	wake_up_interruptible(&rewind_input_wait);
+}
+
+/*
+ * The monitor's one interrupt. A timer that is due runs the clock event
+ * handler. A preemption request marks the current task for rescheduling,
+ * so the scheduler picks again on the way back to user space: this is how
+ * the monitor explores other interleavings of the same run, at a chosen
+ * step and without moving time. An inspection request is handed to a
+ * worker, which can start a process.
+ */
+DEFINE_IDTENTRY_SYSVEC(sysvec_rewind_callback)
+{
+	struct pt_regs *old_regs = set_irq_regs(regs);
+	u32 pending = xchg(&rewind_shared.pending, 0);
+
+	apic_eoi();
+	inc_irq_stat(HYPERVISOR_CALLBACK);
+
+	if ((pending & REWIND_PENDING_TIMER) && rewind_clockevent.event_handler)
+		rewind_clockevent.event_handler(&rewind_clockevent);
+
+	if (pending & REWIND_PENDING_PREEMPT) {
+		set_tsk_need_resched(current);
+		set_preempt_need_resched();
+	}
+
+	if (pending & REWIND_PENDING_INPUT)
+		rewind_take_input();
+
+	if (pending & REWIND_PENDING_STALL)
+		rewind_stall_current();
+
+	if (pending & REWIND_PENDING_INSPECT) {
+		WRITE_ONCE(rewind_inspecting, true);
+		WRITE_ONCE(rewind_inspect_running,
+			   (current->flags & PF_KTHREAD) || !current->mm ?
+			   0 : task_tgid_nr(current));
+		rewind_stop_user_tasks();
+		/*
+		 * An inspection can be a shell that runs for as long as
+		 * someone types into it, so it goes on the queue for long work.
+		 */
+		queue_work(system_long_wq, &rewind_inspect_work);
+		set_tsk_need_resched(current);
+		set_preempt_need_resched();
+	}
+
+	set_irq_regs(old_regs);
+}
+
+static void __init rewind_timer_init(void)
+{
+	/*
+	 * A nonzero period tells the local APIC code its timer is already
+	 * calibrated. The calibration loop would otherwise spin waiting for
+	 * ticks that only an exit can deliver.
+	 */
+	lapic_timer_period = 1;
+
+	clocksource_register_hz(&rewind_clocksource, NSEC_PER_SEC);
+
+	rewind_clockevent.cpumask = cpumask_of(0);
+	clockevents_config_and_register(&rewind_clockevent, NSEC_PER_SEC,
+					NSEC_PER_USEC, 0x7fffffff);
+}
+
+/*
+ * Idle: interrupts on, then tell the monitor nothing is runnable. The
+ * monitor advances virtual time to the armed timer and injects it before
+ * the port write completes, so the interrupt is taken right after it,
+ * exactly where HLT would have woken.
+ */
+DECLARE_STATIC_CALL(x86_idle, default_idle);
+
+static void __cpuidle rewind_idle(void)
+{
+	raw_local_irq_enable();
+	outl(0, REWIND_PORT_IDLE);
+	raw_local_irq_disable();
+}
+
+static void rewind_get_wallclock(struct timespec64 *now)
+{
+	now->tv_sec = READ_ONCE(rewind_shared.epoch);
+	now->tv_nsec = 0;
+}
+
+static int rewind_set_wallclock(const struct timespec64 *now)
+{
+	return -ENODEV;
+}
