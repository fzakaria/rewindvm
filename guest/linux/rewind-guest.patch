+static struct console rewind_console = {
+	.name	= "rewind",
+	.write	= rewind_console_write,
+	.flags	= CON_PRINTBUFFER | CON_ANYTIME,
+	.index	= -1,
+};
+
+/*
+ * The CPUs user space is told it has, from rewind.cpus= on the command
+ * line. The machine has one vCPU and this kernel is uniprocessor, so a
+ * count above one changes nothing the kernel does: programs that size
+ * their thread pools by the count start more threads, and those threads
+ * interleave on the one vCPU. Only the affinity system calls answer with
+ * the count here; init writes the sysfs and /proc/cpuinfo files to match.
+ * An affinity mask is one unsigned long on this kernel, so the count is at
+ * most BITS_PER_LONG.
+ */
+static unsigned int rewind_cpus __ro_after_init = 1;
+
+static int __init rewind_parse_cpus(char *arg)
+{
+	unsigned int cpus;
+
+	if (kstrtouint(arg, 10, &cpus) || cpus < 1 || cpus > BITS_PER_LONG) {
+		pr_warn("rewind: ignoring rewind.cpus=%s\n", arg);
+		return 1;
+	}
+	rewind_cpus = cpus;
+	return 1;
+}
+__setup("rewind.cpus=", rewind_parse_cpus);
+
+/* sched_getaffinity: every task may run on every CPU user space is told of. */
+void rewind_report_cpus(struct cpumask *mask)
+{
+	if (rewind_cpus == 1)
+		return;
+	cpumask_bits(mask)[0] = GENMASK(rewind_cpus - 1, 0);
+}
+
+/*
+ * sched_setaffinity: a mask naming any CPU user space is told of means the
+ * one CPU there is. A mask naming none of them stays as it is, and the
+ * scheduler refuses it with EINVAL, as a machine with that many CPUs would.
+ */
+const struct cpumask *rewind_fold_cpus(const struct cpumask *mask)
+{
+	if (rewind_cpus == 1)
+		return mask;
+	if (!(cpumask_bits(mask)[0] & GENMASK(rewind_cpus - 1, 0)))
+		return mask;
+	return cpumask_of(0);
+}
+
+/*
+ * The one local APIC, at its architectural address. There is no MP table,
+ * no ACPI and no I/O APIC: the only interrupt is the monitor's, sent as an
+ * MSI to HYPERVISOR_CALLBACK_VECTOR.
+ */
+static void __init rewind_parse_smp_config(void)
+{
+	register_lapic_address(APIC_DEFAULT_PHYS_BASE);
+	topology_register_apic(0, CPU_ACPIID_INVALID, true);
+	smp_found_config = 1;
+}
+
+/* The task list's layout, for the monitor (struct rewind_tasks). */
+static void __init rewind_publish_tasks(void)
+{
+	struct rewind_tasks *t = &rewind_shared.tasks;
+
+	BUILD_BUG_ON(sizeof(struct pt_regs) != REWIND_PT_REGS_WORDS * sizeof(u64));
+	BUILD_BUG_ON(offsetof(struct pt_regs, ss) !=
+		     (REWIND_PT_REGS_WORDS - 1) * sizeof(u64));
+
+	t->init_task = (u64)&init_task;
+	t->current_task = (u64)per_cpu_ptr(&current_task, 0);
+	t->page_offset = PAGE_OFFSET;
+	t->tasks = offsetof(struct task_struct, tasks);
+	t->thread_node = offsetof(struct task_struct, thread_node);
+	t->signal = offsetof(struct task_struct, signal);
+	t->pid = offsetof(struct task_struct, pid);
+	t->tgid = offsetof(struct task_struct, tgid);
+	t->stack = offsetof(struct task_struct, stack);
+	t->mm = offsetof(struct task_struct, mm);
+	t->comm = offsetof(struct task_struct, comm);
+	t->thread_head = offsetof(struct signal_struct, thread_head);
+	t->pgd = offsetof(struct mm_struct, pgd);
+	t->pt_regs = THREAD_SIZE - TOP_OF_KERNEL_STACK_PADDING -
+		     sizeof(struct pt_regs);
+}
+
+static void __init rewind_init_platform(void)
+{
+	rewind_running = true;
+	rewind_publish_tasks();
+	outl(__pa_symbol(&rewind_shared), REWIND_PORT_SETUP);
+
+	sysvec_install(HYPERVISOR_CALLBACK_VECTOR, sysvec_rewind_callback);
+
+	x86_init.irqs.pre_vector_init		= x86_init_noop;
+	x86_init.timers.timer_init		= rewind_timer_init;
+	x86_init.mpparse.find_mptable		= x86_init_noop;
+	x86_init.mpparse.early_parse_smp_cfg	= x86_init_noop;
+	x86_init.mpparse.parse_smp_cfg		= rewind_parse_smp_config;
+
+	x86_platform.get_wallclock		= rewind_get_wallclock;
+	x86_platform.set_wallclock		= rewind_set_wallclock;
+	x86_platform.legacy.rtc			= 0;
+	x86_platform.legacy.warm_reset		= 0;
+	x86_platform.legacy.i8042		= X86_LEGACY_I8042_PLATFORM_ABSENT;
+
+	legacy_pic				= &null_legacy_pic;
+
+	pm_power_off				= rewind_power_off;
+	machine_ops.power_off			= rewind_power_off;
+	machine_ops.restart			= rewind_restart;
+	machine_ops.emergency_restart		= rewind_emergency_restart;
+	machine_ops.halt			= rewind_halt;
+
+	static_call_update(x86_idle, rewind_idle);
+
+	register_console(&rewind_console);
+}
