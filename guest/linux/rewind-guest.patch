+/*
+ * The input image is legacy persistent memory, which the kernel leaves out
+ * of the iomem tree at boot and inserts from the PCI resource survey. This
+ * kernel has no PCI, so the platform does the insertion itself, before the
+ * e820 pmem driver looks for the range at device initcall time.
+ */
+static int __init rewind_reserve_resources(void)
+{
+	if (rewind_running)
+		e820__reserve_resources_late();
+	return 0;
+}
+subsys_initcall(rewind_reserve_resources);
+
+static bool __init rewind_x2apic_available(void)
+{
+	return false;
+}
+
+const __initconst struct hypervisor_x86 x86_hyper_rewind = {
+	.name			= "Rewind",
+	.detect			= rewind_detect,
+	.type			= X86_HYPER_REWIND,
+	.init.init_platform	= rewind_init_platform,
+	.init.x2apic_available	= rewind_x2apic_available,
+	.ignore_nopv		= true,
+};
+
+/*
+ * Events. Everything below reports what the guest does; none of it changes
+ * what the guest does, beyond the exit each record costs.
+ */
+
+static inline bool rewind_active(void)
+{
+	return hypervisor_is_type(X86_HYPER_REWIND);
+}
+
+/*
+ * RDTSC and RDTSCP from user space. KVM cannot trap them for the monitor,
+ * so the kernel does: every user task runs with CR4.TSD set (see
+ * rewind_events_init), the instruction raises #GP, and the fault handler
+ * lands here. The counter a program reads is the virtual clock in
+ * nanoseconds, which moves the way the rest of the guest's time does.
+ */
+bool rewind_fixup_rdtsc(struct pt_regs *regs)
+{
+	u8 insn[3];
+	unsigned int len;
+	u64 now;
+
+	if (!rewind_active())
+		return false;
+	if (copy_from_user(insn, (void __user *)regs->ip, 2))
+		return false;
+
+	if (insn[0] == 0x0f && insn[1] == 0x31) {
+		len = 2;
+	} else if (insn[0] == 0x0f && insn[1] == 0x01) {
+		if (copy_from_user(&insn[2], (void __user *)(regs->ip + 2), 1) ||
+		    insn[2] != 0xf9)
+			return false;
+		len = 3;
+		regs->cx = 0;
+	} else {
+		return false;
+	}
+
+	now = rewind_clock_read(&rewind_clocksource);
+	regs->ax = lower_32_bits(now);
+	regs->dx = upper_32_bits(now);
+	regs->ip += len;
+	return true;
+}
+
+static void rewind_probe_exec(void *data, struct task_struct *p,
+			      pid_t old_pid, struct linux_binprm *bprm)
+{
+	static char args[1024];
+	struct mm_struct *mm = p->mm;
+	size_t len = 0;
+
+	/*
+	 * The arguments sit on the new stack, written moments ago by exec, so
+	 * a no-fault copy finds them resident.
+	 */
+	if (mm && mm->arg_end > mm->arg_start) {
+		len = min_t(size_t, mm->arg_end - mm->arg_start, sizeof(args));
+		if (copy_from_user_nofault(args, (void __user *)mm->arg_start,
+					   len))
+			len = 0;
+	}
+
+	rewind_emit(REWIND_EV_EXEC, 0, p->tgid, p->pid, old_pid,
+		    bprm->filename, strlen(bprm->filename) + 1, args, len);
+}
+
+static void rewind_probe_fork(void *data, struct task_struct *parent,
+			      struct task_struct *child)
+{
+	u16 flags = child->tgid == parent->tgid ? REWIND_FLAG_THREAD : 0;
+
+	rewind_emit(REWIND_EV_FORK, flags, parent->tgid, parent->pid,
+		    child->pid, NULL, 0, NULL, 0);
+}
+
+static void rewind_probe_exit(void *data, struct task_struct *p,
+			      bool group_dead)
+{
+	u16 flags = p->pid != p->tgid ? REWIND_FLAG_THREAD : 0;
+
+	rewind_emit(REWIND_EV_EXIT, flags, p->tgid, p->pid, p->exit_code,
+		    p->comm, strnlen(p->comm, TASK_COMM_LEN), NULL, 0);
+}
+
+static void rewind_probe_signal(void *data, int sig,
+				struct kernel_siginfo *info,
+				struct k_sigaction *ka)
+{
+	struct {
+		s32 code;
+		u64 addr;
+	} __packed detail = {};
+
+	/*
+	 * A SIGKILL the kernel queues itself while a thread group exits is
+	 * not a signal anyone sent. exit_group queues one to every other
+	 * thread, which says nothing, and a fatal signal such as SIGPIPE that
+	 * does not dump core is turned into one for every thread, which hides
+	 * it. Report the signal the group is dying of, once, on its leader.
+	 */
+	if (sig == SIGKILL && (current->signal->flags & SIGNAL_GROUP_EXIT)) {
+		int cause = current->signal->group_exit_code & 0x7f;
+
+		if (!cause || cause == SIGKILL || current->pid != current->tgid)
+			return;
+		rewind_emit(REWIND_EV_SIGNAL, 0, current->tgid, current->pid,
+			    cause, &detail, sizeof(detail), NULL, 0);
+		return;
+	}
+
+	if (info) {
+		detail.code = info->si_code;
+		if (sig == SIGSEGV || sig == SIGBUS || sig == SIGILL ||
+		    sig == SIGFPE)
+			detail.addr = (u64)info->si_addr;
+	}
+
+	rewind_emit(REWIND_EV_SIGNAL, 0, current->tgid, current->pid, sig,
+		    &detail, sizeof(detail), NULL, 0);
+}
+
+/*
+ * Paths for file events. The system call tracepoints may fault and sleep
+ * here, so the argument is read even when it is not resident, and one
+ * mutex guards the buffers a sleeping reporter would otherwise share.
+ */
+static DEFINE_MUTEX(rewind_path_lock);
+static char rewind_path_a[PATH_MAX], rewind_path_b[PATH_MAX];
+static char rewind_path_arg[PATH_MAX];
+
+/*
+ * Drops "." components and applies ".." ones to an absolute path, in
+ * place. Lexical, like a reader would: a ".." after a symlink names the
+ * link's parent here, where the kernel follows the link.
+ */
+static void rewind_normalize_path(char *path)
+{
+	char *out = path, *in = path;
+
+	while (*in) {
+		char *end;
+		size_t len;
+
+		while (*in == '/')
+			in++;
+		end = strchrnul(in, '/');
+		len = end - in;
+
+		if (len == 0 || (len == 1 && in[0] == '.')) {
+			/* Nothing to keep. */
+		} else if (len == 2 && in[0] == '.' && in[1] == '.') {
+			while (out > path && *--out != '/')
+				;
+		} else {
+			*out++ = '/';
+			memmove(out, in, len);
+			out += len;
+		}
+		in = end;
+	}
+	if (out == path)
+		*out++ = '/';
+	*out = '\0';
+}
+
+/*
+ * A path argument as an absolute path in the process's root. A relative
+ * path is joined to the directory it is relative to, the working directory
+ * or the one dfd names, so the file can be found again after the process
+ * has moved or exited. False when the path cannot be read or resolved.
+ */
+static bool rewind_user_path(char *dst, int dfd, unsigned long src)
+{
+	char *rel = rewind_path_arg;
+	struct path base;
+	struct file *dir;
+	size_t len;
+	char *at;
+	long n;
+
+	n = strncpy_from_user(rel, (const char __user *)src, PATH_MAX);
+	if (n <= 0 || n >= PATH_MAX)
+		return false;
+	if (rel[0] == '/') {
+		strscpy(dst, rel, PATH_MAX);
+		rewind_normalize_path(dst);
+		return true;
+	}
+
+	/* The directory the path is relative to. */
+	if (dfd == AT_FDCWD) {
+		get_fs_pwd(current->fs, &base);
+	} else {
+		dir = fget(dfd);
+		if (!dir)
+			return false;
+		base = dir->f_path;
+		path_get(&base);
+		fput(dir);
+	}
+	at = d_path(&base, dst, PATH_MAX);
+	path_put(&base);
+	if (IS_ERR(at))
+		return false;
+
+	/* The directory, a slash, then the path, without . and .. parts. */
+	len = strlen(at);
+	memmove(dst, at, len + 1);
+	if (len + 1 + strlen(rel) >= PATH_MAX)
+		return false;
+	dst[len++] = '/';
+	strscpy(dst + len, rel, PATH_MAX - len);
+	rewind_normalize_path(dst);
+	return true;
+}
+
+static void rewind_report_open(int dfd, unsigned long path,
+			       unsigned long flags)
+{
+	/* Only opens that can change a file are interesting. */
+	if ((flags & O_ACCMODE) == O_RDONLY && !(flags & (O_CREAT | O_TRUNC)))
+		return;
+	if (!rewind_user_path(rewind_path_a, dfd, path))
+		return;
+
+	rewind_emit(REWIND_EV_OPEN, 0, current->tgid, current->pid, flags,
+		    rewind_path_a, strlen(rewind_path_a), NULL, 0);
+}
+
+static void rewind_report_unlink(int dfd, unsigned long path)
+{
+	if (!rewind_user_path(rewind_path_a, dfd, path))
+		return;
+
+	rewind_emit(REWIND_EV_UNLINK, 0, current->tgid, current->pid, 0,
+		    rewind_path_a, strlen(rewind_path_a), NULL, 0);
+}
+
+static void rewind_report_rename(int from_dfd, unsigned long from,
+				 int to_dfd, unsigned long to)
+{
+	if (!rewind_user_path(rewind_path_a, from_dfd, from) ||
+	    !rewind_user_path(rewind_path_b, to_dfd, to))
+		return;
+
+	rewind_emit(REWIND_EV_RENAME, 0, current->tgid, current->pid, 0,
+		    rewind_path_a, strlen(rewind_path_a) + 1,
+		    rewind_path_b, strlen(rewind_path_b));
+}
+
+static void rewind_probe_sys_enter(void *data, struct pt_regs *regs, long id)
+{
+	/*
+	 * Init during an inspection: wait here, at a point where it has done
+	 * nothing yet, until the inspection is over. An idle wait, so the
+	 * hung task detector leaves it be.
+	 */
+	if (unlikely(READ_ONCE(rewind_inspecting)) && is_global_init(current))
+		wait_event_idle(rewind_inspect_done, !READ_ONCE(rewind_inspecting));
+
+	if (in_ia32_syscall())
+		return;
+
+	mutex_lock(&rewind_path_lock);
+	switch (id) {
+	case __NR_open:
+		rewind_report_open(AT_FDCWD, regs->di, regs->si);
+		break;
+	case __NR_openat:
+		rewind_report_open(regs->di, regs->si, regs->dx);
+		break;
+	case __NR_creat:
+		rewind_report_open(AT_FDCWD, regs->di,
+				   O_CREAT | O_WRONLY | O_TRUNC);
+		break;
+	case __NR_unlink:
+		rewind_report_unlink(AT_FDCWD, regs->di);
+		break;
+	case __NR_unlinkat:
+		rewind_report_unlink(regs->di, regs->si);
+		break;
+	case __NR_rename:
+		rewind_report_rename(AT_FDCWD, regs->di, AT_FDCWD, regs->si);
+		break;
+	case __NR_renameat:
+	case __NR_renameat2:
+		rewind_report_rename(regs->di, regs->si, regs->dx, regs->r10);
+		break;
+	}
+	mutex_unlock(&rewind_path_lock);
+}
+
+/*
+ * /dev/rewind-stdout and /dev/rewind-stderr. The guest init points the
+ * workload's standard output and error at these, so every write arrives
+ * with the pid that made it. /dev/rewind takes marks: a line written there
+ * becomes a labelled point on the timeline.
+ */
+
+static DEFINE_MUTEX(rewind_write_lock);
+static u8 rewind_bounce[4096];
+
+static ssize_t rewind_write(struct file *file, const char __user *ubuf,
+			    size_t len, u16 kind, u32 aux)
+{
+	size_t done = 0;
+
+	mutex_lock(&rewind_write_lock);
+	while (done < len) {
+		size_t n = min(len - done, sizeof(rewind_bounce));
+
+		if (copy_from_user(rewind_bounce, ubuf + done, n)) {
+			mutex_unlock(&rewind_write_lock);
+			return done ? done : -EFAULT;
+		}
+		rewind_emit(kind, 0, current->tgid, current->pid, aux,
+			    rewind_bounce, n, NULL, 0);
+		done += n;
+	}
+	mutex_unlock(&rewind_write_lock);
+	return done;
+}
+
+static ssize_t rewind_stdout_write(struct file *file, const char __user *buf,
+				   size_t len, loff_t *off)
+{
+	return rewind_write(file, buf, len, REWIND_EV_OUTPUT, 1);
+}
+
+static ssize_t rewind_stderr_write(struct file *file, const char __user *buf,
+				   size_t len, loff_t *off)
+{
+	return rewind_write(file, buf, len, REWIND_EV_OUTPUT, 2);
+}
+
+static ssize_t rewind_mark_write(struct file *file, const char __user *buf,
+				 size_t len, loff_t *off)
+{
+	return rewind_write(file, buf, len, REWIND_EV_MARK, 0);
+}
+
+/*
+ * /dev/rewind-console: a byte stream to and from the monitor, for a shell
+ * started by an inspection. Writes are output records on REWIND_TERM_FD;
+ * reads return the monitor's input.
+ */
+#define REWIND_TERM_FD	3
+
+static ssize_t rewind_term_write(struct file *file, const char __user *buf,
+				    size_t len, loff_t *off)
+{
+	return rewind_write(file, buf, len, REWIND_EV_OUTPUT,
+			    REWIND_TERM_FD);
+}
+
+static ssize_t rewind_term_read(struct file *file, char __user *buf,
+				   size_t len, loff_t *off)
+{
+	unsigned int copied;
+	int err;
+
+	if (kfifo_is_empty(&rewind_input)) {
+		if (file->f_flags & O_NONBLOCK)
+			return -EAGAIN;
+		err = wait_event_interruptible(rewind_input_wait,
+					       !kfifo_is_empty(&rewind_input));
+		if (err)
+			return err;
+	}
+	err = kfifo_to_user(&rewind_input, buf, len, &copied);
+	return err ? err : copied;
+}
+
+static __poll_t rewind_term_poll(struct file *file, poll_table *wait)
+{
+	poll_wait(file, &rewind_input_wait, wait);
+	return EPOLLOUT | EPOLLWRNORM |
+	       (kfifo_is_empty(&rewind_input) ? 0 : EPOLLIN | EPOLLRDNORM);
+}
+
+static const struct file_operations rewind_term_fops = {
+	.owner	= THIS_MODULE,
+	.read	= rewind_term_read,
+	.write	= rewind_term_write,
+	.poll	= rewind_term_poll,
+};
+
+static const struct file_operations rewind_stdout_fops = {
+	.owner	= THIS_MODULE,
+	.write	= rewind_stdout_write,
+};
+
+static const struct file_operations rewind_stderr_fops = {
+	.owner	= THIS_MODULE,
+	.write	= rewind_stderr_write,
+};
+
+static const struct file_operations rewind_mark_fops = {
+	.owner	= THIS_MODULE,
+	.write	= rewind_mark_write,
+};
+
+static struct miscdevice rewind_devices[] = {
+	{ MISC_DYNAMIC_MINOR, "rewind-stdout", &rewind_stdout_fops,
+	  .mode = 0666 },
+	{ MISC_DYNAMIC_MINOR, "rewind-stderr", &rewind_stderr_fops,
+	  .mode = 0666 },
+	{ MISC_DYNAMIC_MINOR, "rewind", &rewind_mark_fops, .mode = 0666 },
+	{ MISC_DYNAMIC_MINOR, "rewind-console", &rewind_term_fops,
+	  .mode = 0600 },
+};
+
+static int __init rewind_events_init(void)
+{
+	int i, err;
+
+	if (!rewind_active())
+		return 0;
+
+	/*
+	 * Initcalls run as pid 1, and every user task descends from it, so
+	 * setting TIF_NOTSC here traps RDTSC in all of them.
+	 */
+	disable_TSC();
+
+	for (i = 0; i < ARRAY_SIZE(rewind_devices); i++) {
+		err = misc_register(&rewind_devices[i]);
+		if (err)
+			return err;
+	}
+
+	WARN_ON(register_trace_sched_process_exec(rewind_probe_exec, NULL));
+	WARN_ON(register_trace_sched_process_fork(rewind_probe_fork, NULL));
+	WARN_ON(register_trace_sched_process_exit(rewind_probe_exit, NULL));
+	WARN_ON(register_trace_signal_deliver(rewind_probe_signal, NULL));
+	WARN_ON(register_trace_sys_enter(rewind_probe_sys_enter, NULL));
+	WARN_ON(register_reboot_notifier(&rewind_reboot_nb));
+	return 0;
+}
+device_initcall(rewind_events_init);
